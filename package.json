{
  "name": "pkgv",
  "version": "0.0.1-alpha.0",
  "description": "",
  "keywords": [
    "pkgv",
    "package",
    "version",
    "versions"
  ],
  "homepage": "https://github.com/Arnesfield/pkgv#readme",
  "bugs": {
    "url": "https://github.com/Arnesfield/pkgv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arnesfield/pkgv.git"
  },
  "license": "MIT",
  "author": "Jefferson Rylee <rylee.jeff385@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "npm run check -- npm:bundle",
    "prebundle": "rimraf lib",
    "bundle": "rollup -c rollup.config.ts --configPlugin \"esbuild={target:'esnext'}\" --configImportAttributesKey with",
    "check": "concurrently -r --kill-others-on-fail tsc \"npm:lint -- --max-warnings 0\"",
    "format": "npm run lint -- --fix && prettier -cw .",
    "lint": "eslint .",
    "start": "npm run watch -- --environment NODE_ENV:development",
    "test": "npm run check -- mocha",
    "test:watch": "mocha -w",
    "watch": "npm run bundle -- -w --no-watch.clearScreen"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-eslint": "^9.2.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.4.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "eslint-plugin-jsdoc": "^62.8.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.59.0",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-output-size": "^2.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
